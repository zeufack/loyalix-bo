# Dependencies (installed inside the image, never copy from host)
node_modules/
.pnp/
.pnp.js
.pnpm-store/

# Next.js build output (generated during the image build)
.next/
out/
build/
.vercel/

# Testing (not needed in the production image)
coverage/
playwright-report/
test-results/
tests/

# Environment files (avoid leaking secrets into the build context)
.env
.env*
!.env.dokploy.example

# Debug and log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# IDE and editor files
.vscode/
.idea/
.cursor/
.cursorrules
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# Docker files (reduce build context; not needed inside the image)
Dockerfile*
.dockerignore
docker-compose*.yml
compose*.yaml

# Documentation (not needed in the image)
*.md
docs/

# CI/CD (not needed in the image)
.github/

# TypeScript and build metadata
*.tsbuildinfo

# Cache and temporary directories
.cache/
.turbo/
.tmp/
.temp/

# OS-specific files
.DS_Store
._*
Thumbs.db
