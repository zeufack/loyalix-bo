# ==========================================================================
# Reference for the variables to set in the Dokploy project's "Environment"
# tab (NOT committed with real values — secrets stay in Dokploy).
#
# This test env is wired to the PRODUCTION NestJS backend (loyal-ix.com) —
# there is currently no separate staging API. Traffic/writes from this
# environment hit real backend data. Point NESTJS_API_URL /
# NEXT_PUBLIC_NESTJS_API_URL at a staging backend here once one exists.
# ==========================================================================

# ---------- routing (consumed by docker-compose.yml labels) ----------
# STACK_NAME must be UNIQUE per Dokploy project (used for Traefik router/service names).
# APP_HOST is the public hostname Traefik routes to this service.
STACK_NAME=loyalix-bo-dev
APP_HOST=bo-dev.loyal-ix.com
CERT_RESOLVER=letsencrypt

# ---------- auth (Auth.js / NextAuth v5) ----------
# Must be the public https URL of THIS environment (session cookie + callbacks).
NEXTAUTH_URL=https://bo-dev.loyal-ix.com
NEXTAUTH_SECRET=__generate__            # openssl rand -base64 32

# ---------- backend API ----------
# Server-side (route handlers, server actions, auth.config.ts) — read at
# request time, safe to change without rebuilding the image.
NESTJS_API_URL=https://loyal-ix.com/api/v1

# Client-side (browser bundle: hooks/useEventSource.ts, app/api/http.ts) —
# inlined into the JS bundle at BUILD time via the Dockerfile's build arg.
# Changing this requires a rebuild, not just a container restart.
NEXT_PUBLIC_NESTJS_API_URL=https://loyal-ix.com/api/v1

# ---------- required on the BACKEND's own Dokploy project ----------
# The backend's CORS_ORIGIN must include this environment's APP_HOST or
# every browser request from bo-dev will be blocked by CORS. CORS_ORIGIN
# is comma-separated (src/main.ts), so append rather than replace:
#   CORS_ORIGIN=https://<existing-frontend-origin>,https://bo-dev.loyal-ix.com
